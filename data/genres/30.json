  "category": "shading",
  "rules": {
    "en": {
      "statements": [
        "Shade some dominoes of cells so that every region contains exactly two shaded cells.",
        "Shaded dominoes may not touch orthogonally."
      ],
      "source": "Eric Fox's Dictionary of Rulesets"
    },
    "ja": {
      "statements": [
        "盤面のいくつかの白マスに黒マスがタテヨコに２つ連なったピース（のり）を書き込みます。",
        "のり同士は辺を共有してはいけません。",
        "太線で区切られた領域には黒マスが２つずつ入ります。"
      ],
      "source": "Puzsq Rules"
    }
  },

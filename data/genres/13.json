    "en": {
      "statements": [
        "Draw a non-intersecting loop through the centers of all empty cells."
      ],
      "source": "Eric Fox's Dictionary of Rulesets"
    },
    "ja": {
      "statements": [
        "盤面の白マスにタテヨコに線を引き、すべての白マスを通る１つの輪っかを作ります。",
        "輪っかを作る線は交差したり枝分かれしたり行き止まりがあったりしてはいけません。"
      ],
      "source": "Puzsq Rules"
    },
    "cs": {
      "statements": [
        "Nakresli jednu uzavřenou čáru (smyčku), která se nekříží ani sama sebe nedotýká, a prochází středy všech prázdných polí ve vodorovném či svislém směru."
      ],
      "source": "Dlouhodobá soutěž HALAS",
      "note": "Reworded"
    }
  },
